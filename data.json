  "philosophy": [
    {
      "id": 1,
      "title": "User-Centered Design",
      "description": "Every design decision starts and ends with the user. I advocate for deep user research, empathy mapping, and continuous testing to ensure products genuinely serve people's needs — not just business assumptions."
    },
    {
      "id": 2,
      "title": "Iterative Approach",
      "description": "Great design is never finished on the first pass. I embrace rapid prototyping and continuous iteration — shipping, learning, and refining based on real-world feedback rather than internal consensus."
    },
    {
      "id": 3,
      "title": "Interdisciplinary Collaboration",
      "description": "Design thrives at intersections. I work closely with engineers, product managers, and business stakeholders to build solutions that are technically feasible, commercially viable, and delightful to use."
    },
    {
      "id": 4,
      "title": "Data-Driven Decisions",
      "description": "Intuition is a starting point, not an endpoint. I combine qualitative insights with quantitative data to validate assumptions and measure the real impact of design on people and business outcomes."
    }
  ],
  "about": {
    "photo": "/assets/images/pavel-photo.jpg",
    "headline": "Pavel is a designer and leader, based in 🏰 Krakow, Poland.",
    "bio": "I'm a digital product designer and leader based in Krakow, Poland. With over a decade of experience designing digital products, I specialise in creating experiences that balance user needs with business goals — and in building the teams and systems that make great design repeatable.",
    "bio2": "I've had the privilege of working with fast-growing startups and established companies across fintech, edtech, and SaaS. I believe great design is invisible — it just works.",
    "bio3": "Outside of work I'm drawn to typography, film photography, and long trail runs in the mountains.",
